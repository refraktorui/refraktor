{
    "$schema": "https://turbo.build/schema.json",
    "globalDependencies": ["**/.env.*.local"],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["build/**", "dist/**", "**/.tsbuildinfo"]
        },
        "dev": {
            "cache": false,
            "persistent": true
        },
        "lint": {
            "dependsOn": ["^lint"]
        },
        "test": {
            "dependsOn": ["^build"]
        },
        "clean": {
            "cache": false
        }
    }
}
