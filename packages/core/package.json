{
    "name": "@refraktor/core",
    "version": "0.0.1-alpha.0",
    "license": "MIT",
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./style.css": "./build/style.css"
    },
    "scripts": {
        "build": "tsc && cpy src/style.css build/ --flat",
        "dev": "concurrently \"tsc --watch\" \"cpy src/style.css build/ --watch --flat\"",
        "clean": "rm -rf build"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@refraktor/utils": "workspace:*",
        "typescript": "^5.9.3"
    }
}
