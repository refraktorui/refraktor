{
    "name": "@refraktor/core",
    "version": "0.0.1-alpha.0",
    "license": "MIT",
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./style.css": "./build/style.css"
    },
    "scripts": {
        "build": "tsc && cpy src/style.css build/ --flat",
        "dev": "concurrently \"tsc --watch\" \"cpy src/style.css build/ --watch --flat\"",
        "test": "vitest"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0"
    },
    "devDependencies": {
        "@refraktor/utils": "workspace:*",
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.6",
        "clsx": "^2.1.1",
        "react-remove-scroll": "^2.7.2",
        "react-textarea-autosize": "^8.5.9",
        "tailwind-merge": "^3.4.0"
    }
}
