{
    "name": "@refraktor/core",
    "description": "React UI component library built with Tailwind CSS v4",
    "version": "0.0.9",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/refraktorui/refraktor.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/refraktorui/refraktor/issues"
    },
    "keywords": [
        "react",
        "ui",
        "ui-kit",
        "component",
        "design",
        "frontend",
        "tailwindcss",
        "tailwind"
    ],
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "build",
        "README.md",
        "LICENSE"
    ],
    "main": "./build/index.js",
    "module": "./build/index.js",
    "types": "./build/index.d.ts",
    "exports": {
        ".": {
            "types": "./build/index.d.ts",
            "import": "./build/index.js"
        },
        "./style.css": "./build/style.css"
    },
    "scripts": {
        "build": "tsc && tailwindcss -i src/style.css -o build/style.css --minify",
        "dev": "concurrently \"tsc --watch\" \"tailwindcss -i src/style.css -o build/style.css --watch\"",
        "test": "vitest"
    },
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-dom": ">=18.0.0",
        "@refraktor/utils": "0.0.9"
    },
    "devDependencies": {
        "typescript": "^5.9.3"
    },
    "dependencies": {
        "@floating-ui/react": "^0.27.18",
        "clsx": "^2.1.1",
        "react-remove-scroll": "^2.7.2",
        "react-textarea-autosize": "^8.5.9",
        "tailwind-merge": "^3.4.0"
    }
}
